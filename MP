<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Daniel Krba — Portfolio</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a0f;
      --surface: #111118;
      --surface2: #16161f;
      --border: #1e1e2e;
      --accent: #7c6ff7;
      --accent2: #f7786f;
      --accent3: #6ff7c4;
      --warn: #f7c56f;
      --text: #e8e8f0;
      --muted: #5a5a7a;
      --font: 'Syne', sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }

    html { scroll-behavior: smooth; }
    body { background: var(--bg); color: var(--text); font-family: var(--font); min-height: 100vh; }

    /* ── NAV ── */
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 200;
      background: rgba(10,10,15,0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2.5rem; height: 58px;
    }
    .nav-logo { font-size: 1rem; font-weight: 800; letter-spacing: -0.02em; color: var(--accent); cursor: pointer; }
    .nav-links { display: flex; gap: 4px; }
    .nav-link {
      font-family: var(--mono); font-size: 0.78rem;
      padding: 6px 14px; border-radius: 8px;
      color: var(--muted); cursor: pointer;
      border: 1px solid transparent;
      transition: all 0.18s; user-select: none;
    }
    .nav-link:hover { color: var(--text); background: var(--surface2); }
    .nav-link.active { color: var(--text); background: var(--surface2); border-color: var(--border); }

    /* ── PAGES ── */
    .page { display: none; padding-top: 58px; min-height: 100vh; }
    .page.active { display: block; }

    /* ══════════════════════════
       PAGE: HOME / PORTFOLIO
    ══════════════════════════ */
    .hero {
      min-height: calc(100vh - 58px);
      display: flex; flex-direction: column; justify-content: center;
      padding: 4rem 2.5rem;
    }
    .hero-tag {
      font-family: var(--mono); font-size: 0.75rem; color: var(--accent);
      letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 1.5rem;
    }
    .hero h1 {
      font-size: clamp(3.5rem, 10vw, 8rem); font-weight: 800;
      line-height: 0.95; letter-spacing: -0.04em; max-width: 900px;
    }
    .hero h1 span { color: var(--accent); }
    .hero-sub {
      font-family: var(--mono); font-size: 0.9rem; color: var(--muted);
      margin-top: 2rem; max-width: 480px; line-height: 1.8;
    }
    .hero-cta { margin-top: 3rem; display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary {
      padding: 0.75rem 1.75rem; background: var(--accent); color: #fff;
      font-family: var(--font); font-weight: 700; font-size: 0.88rem;
      border: none; cursor: pointer; text-decoration: none; border-radius: 8px;
      transition: opacity 0.2s, transform 0.15s;
    }
    .btn-primary:hover { opacity: 0.88; transform: translateY(-2px); }
    .btn-secondary {
      padding: 0.75rem 1.75rem; background: transparent; color: var(--text);
      font-family: var(--mono); font-size: 0.82rem;
      border: 1px solid var(--border); cursor: pointer;
      text-decoration: none; border-radius: 8px; transition: border-color 0.2s, color 0.2s;
    }
    .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }

    .marquee-wrap {
      overflow: hidden; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      padding: 0.9rem 0; background: var(--surface);
    }
    .marquee {
      display: flex; gap: 3rem; width: max-content;
      animation: marquee 22s linear infinite;
      font-family: var(--mono); font-size: 0.75rem; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .marquee em { color: var(--accent); font-style: normal; }

    /* projects section on home */
    .section { padding: 5rem 2.5rem; }
    .section-label {
      font-family: var(--mono); font-size: 0.68rem; color: var(--accent);
      letter-spacing: 0.2em; text-transform: uppercase;
      margin-bottom: 2.5rem; display: flex; align-items: center; gap: 1rem;
    }
    .section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.25rem; }
    .project-card {
      border: 1px solid var(--border); background: var(--surface);
      padding: 2rem; border-radius: 12px; position: relative; overflow: hidden;
      transition: border-color 0.2s, transform 0.2s; cursor: default;
    }
    .project-card::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
      background: var(--accent); transform: scaleX(0); transform-origin: left;
      transition: transform 0.3s; border-radius: 12px 12px 0 0;
    }
    .project-card:hover { border-color: #333; transform: translateY(-4px); }
    .project-card:hover::before { transform: scaleX(1); }
    .project-num { font-family: var(--mono); font-size: 0.68rem; color: var(--muted); margin-bottom: 1.25rem; }
    .project-title { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 0.6rem; }
    .project-desc { font-family: var(--mono); font-size: 0.8rem; color: var(--muted); line-height: 1.7; margin-bottom: 1.5rem; }
    .project-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .tag { font-family: var(--mono); font-size: 0.68rem; padding: 3px 10px; border: 1px solid var(--border); color: var(--muted); border-radius: 4px; }

    /* skills */
    .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem; }
    .skill-item { border: 1px solid var(--border); padding: 1.25rem 1.5rem; background: var(--surface); border-radius: 10px; }
    .skill-name { font-size: 0.88rem; font-weight: 700; margin-bottom: 0.6rem; }
    .skill-bar { height: 2px; background: var(--border); position: relative; border-radius: 2px; }
    .skill-fill { position: absolute; top: 0; left: 0; bottom: 0; background: var(--accent); width: 0; transition: width 1.2s cubic-bezier(0.4,0,0.2,1); border-radius: 2px; }

    /* about */
    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
    .about-text { font-family: var(--mono); font-size: 0.88rem; color: var(--muted); line-height: 1.9; }
    .about-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .stat { border-top: 1px solid var(--border); padding-top: 1rem; }
    .stat-num { font-size: 2.5rem; font-weight: 800; color: var(--accent); letter-spacing: -0.04em; line-height: 1; }
    .stat-label { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-top: 0.4rem; text-transform: uppercase; letter-spacing: 0.1em; }

    /* contact */
    .contact-inner { border: 1px solid var(--border); background: var(--surface); padding: 4rem; text-align: center; border-radius: 16px; }
    .contact-inner h2 { font-size: clamp(2rem, 5vw, 4rem); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem; }
    .contact-inner h2 span { color: var(--accent); }
    .contact-inner p { font-family: var(--mono); font-size: 0.88rem; color: var(--muted); margin-bottom: 2.5rem; }

    /* ══════════════════════════
       PAGE: DASHBOARD
    ══════════════════════════ */
    .dash-wrap { padding: 2rem 2.5rem; }
    .dash-topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .dash-topbar h1 { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em; }
    .dash-sub { font-family: var(--mono); font-size: 0.72rem; color: var(--muted); margin-top: 2px; }
    .topbar-right { display: flex; gap: 0.75rem; align-items: center; }
    .date-badge { font-family: var(--mono); font-size: 0.75rem; color: var(--muted); background: var(--surface); border: 1px solid var(--border); padding: 0.4rem 0.9rem; border-radius: 8px; }
    .refresh-btn { background: var(--accent); color: #fff; border: none; padding: 0.4rem 1rem; border-radius: 8px; font-size: 0.8rem; font-family: var(--font); cursor: pointer; font-weight: 600; transition: opacity 0.2s; }
    .refresh-btn:hover { opacity: 0.85; }

    .kpi-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.25rem; }
    .kpi-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem 1.5rem; position: relative; overflow: hidden; }
    .kpi-card::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; border-radius: 12px 12px 0 0; }
    .kpi-card.c1::after { background: var(--accent); }
    .kpi-card.c2::after { background: var(--accent3); }
    .kpi-card.c3::after { background: var(--warn); }
    .kpi-card.c4::after { background: var(--accent2); }
    .kpi-label { font-size: 0.72rem; color: var(--muted); font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.6rem; }
    .kpi-value { font-size: 1.8rem; font-weight: 800; letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.5rem; }
    .kpi-change { font-size: 0.72rem; font-family: var(--mono); }
    .up { color: var(--accent3); }
    .down { color: var(--accent2); }

    .chart-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .chart-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
    .card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; }
    .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.25rem; }
    .card-title { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.01em; }
    .card-sub { font-size: 0.7rem; color: var(--muted); font-family: var(--mono); margin-top: 2px; }
    .chart-wrap { position: relative; height: 220px; }
    .chart-wrap-sm { position: relative; height: 180px; }

    table { width: 100%; border-collapse: collapse; }
    thead th { font-family: var(--mono); font-size: 0.66rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; text-align: left; padding: 0 0.75rem 0.75rem; border-bottom: 1px solid var(--border); }
    tbody tr { transition: background 0.12s; }
    tbody tr:hover { background: var(--surface2); }
    tbody td { padding: 0.75rem; font-size: 0.82rem; border-bottom: 1px solid var(--border); }
    tbody tr:last-child td { border-bottom: none; }
    .status { display: inline-flex; align-items: center; gap: 5px; font-family: var(--mono); font-size: 0.7rem; padding: 3px 10px; border-radius: 20px; }
    .status-dot { width: 6px; height: 6px; border-radius: 50%; }
    .s-green { background: rgba(111,247,196,0.1); color: var(--accent3); }
    .s-green .status-dot { background: var(--accent3); }
    .s-yellow { background: rgba(247,197,111,0.1); color: var(--warn); }
    .s-yellow .status-dot { background: var(--warn); }
    .s-red { background: rgba(247,120,111,0.1); color: var(--accent2); }
    .s-red .status-dot { background: var(--accent2); }

    /* ══════════════════════════
       PAGE: PROJECTS
    ══════════════════════════ */
    .projects-page { padding: 3rem 2.5rem; }
    .page-hero { margin-bottom: 3rem; }
    .page-hero h1 { font-size: clamp(2.5rem, 6vw, 5rem); font-weight: 800; letter-spacing: -0.04em; }
    .page-hero h1 span { color: var(--accent); }
    .page-hero p { font-family: var(--mono); font-size: 0.88rem; color: var(--muted); margin-top: 1rem; max-width: 500px; line-height: 1.8; }

    .project-full { border: 1px solid var(--border); background: var(--surface); border-radius: 14px; padding: 2.5rem; margin-bottom: 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 2rem; align-items: start; transition: border-color 0.2s; }
    .project-full:hover { border-color: #333; }
    .proj-meta { font-family: var(--mono); font-size: 0.7rem; color: var(--muted); margin-bottom: 0.6rem; }
    .proj-title { font-size: 1.4rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.75rem; }
    .proj-desc { font-family: var(--mono); font-size: 0.82rem; color: var(--muted); line-height: 1.8; margin-bottom: 1.25rem; max-width: 600px; }
    .proj-link { font-family: var(--mono); font-size: 0.78rem; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 1px; cursor: pointer; }
    .proj-num-big { font-size: 5rem; font-weight: 800; color: var(--border); letter-spacing: -0.06em; line-height: 1; user-select: none; }

    /* ══════════════════════════
       PAGE: ABOUT / CONTACT
    ══════════════════════════ */
    .about-page { padding: 3rem 2.5rem; }

    /* FOOTER */
    footer { border-top: 1px solid var(--border); padding: 1.5rem 2.5rem; display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 0.72rem; color: var(--muted); }

    /* ANIMATIONS */
    @keyframes marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
    .page.active { animation: fadeIn 0.3s ease forwards; }

    /* RESPONSIVE */
    @media (max-width: 900px) {
      .kpi-grid { grid-template-columns: repeat(2, 1fr); }
      .chart-grid { grid-template-columns: 1fr; }
      .chart-grid-2 { grid-template-columns: 1fr; }
      .about-grid { grid-template-columns: 1fr; }
      .project-full { grid-template-columns: 1fr; }
      .proj-num-big { display: none; }
      .contact-inner { padding: 2rem; }
    }
    @media (max-width: 600px) {
      nav { padding: 0 1rem; }
      .nav-link { padding: 5px 9px; font-size: 0.72rem; }
      .hero, .section, .dash-wrap, .projects-page, .about-page { padding-left: 1.25rem; padding-right: 1.25rem; }
    }
  </style>
</head>
