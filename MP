<script>
  // ── PAGE SWITCHING ──
  function showPage(name) {
    document.querySelectorAll('.page').forEach(function(p) {
      p.classList.remove('active');
    });
    document.querySelectorAll('.nav-link').forEach(function(l) {
      l.classList.toggle('active', l.dataset.page === name);
    });
    document.getElementById('page-' + name).classList.add('active');
    window.scrollTo(0, 0);

    if (name === 'dashboard' && !window.chartsBuilt) buildCharts();
    if (name === 'home') animateSkills();
  }

  // ── SKILL BARS ──
  function animateSkills() {
    setTimeout(function() {
      document.querySelectorAll('.skill-fill').forEach(function(el) {
        el.style.width = el.dataset.width + '%';
      });
    }, 200);
  }
  animateSkills();

  // ── DATE BADGE ──
  var now = new Date();
  var el = document.getElementById('date-badge');
  if (el) el.textContent = now.toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' });

  // ── CHARTS ──
  window.chartsBuilt = false;

  function buildCharts() {
    window.chartsBuilt = true;

    Chart.defaults.color = '#5a5a7a';
    Chart.defaults.borderColor = '#1e1e2e';
    Chart.defaults.font.family = "'JetBrains Mono', monospace";
    Chart.defaults.font.size = 11;

    var ACCENT  = '#7c6ff7';
    var ACCENT3 = '#6ff7c4';
    var WARN    = '#f7c56f';
    var ACCENT2 = '#f7786f';
    var MUTED   = '#2a2a3e';

    // Revenue
    var rCtx = document.getElementById('revenueChart').getContext('2d');
    var grad = rCtx.createLinearGradient(0, 0, 0, 220);
    grad.addColorStop(0, 'rgba(124,111,247,0.28)');
    grad.addColorStop(1, 'rgba(124,111,247,0)');
    new Chart(rCtx, {
      type: 'line',
      data: {
        labels: ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'],
        datasets: [{ label:'Revenue', data:[42000,38000,55000,47000,61000,58000,72000,68000,75000,71000,83000,84291], borderColor:ACCENT, backgroundColor:grad, borderWidth:2, pointBackgroundColor:ACCENT, pointRadius:3, pointHoverRadius:5, tension:0.4, fill:true }]
      },
      options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ x:{ grid:{ color:'#1e1e2e' } }, y:{ grid:{ color:'#1e1e2e' }, ticks:{ callback: function(v){ return '$'+(v/1000).toFixed(0)+'k'; } } } } }
    });

    // Donut
    new Chart(document.getElementById('donutChart'), {
      type: 'doughnut',
      data: { labels:['Organic','Direct','Social','Referral','Email'], datasets:[{ data:[38,25,18,12,7], backgroundColor:[ACCENT,ACCENT3,WARN,ACCENT2,'#a06ff7'], borderWidth:0, hoverOffset:6 }] },
      options: { responsive:true, maintainAspectRatio:false, cutout:'68%', plugins:{ legend:{ position:'right', labels:{ boxWidth:10, padding:14 } } } }
    });

    // Bar
    new Chart(document.getElementById('barChart'), {
      type: 'bar',
      data: { labels:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'], datasets:[{ label:'Users', data:[420,580,510,670,720,390,310], backgroundColor:[ACCENT,ACCENT,ACCENT,ACCENT,ACCENT,MUTED,MUTED], borderRadius:5, borderSkipped:false }] },
      options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ x:{ grid:{ display:false } }, y:{ grid:{ color:'#1e1e2e' } } } }
    });

    // Radar
    new Chart(document.getElementById('radarChart'), {
      type: 'radar',
      data: { labels:['Speed','SEO','UX','Security','Uptime','Perf'], datasets:[{ label:'Score', data:[88,92,79,95,99,84], borderColor:ACCENT3, backgroundColor:'rgba(111,247,196,0.1)', borderWidth:2, pointBackgroundColor:ACCENT3, pointRadius:3 }] },
      options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } }, scales:{ r:{ grid:{ color:'#1e1e2e' }, ticks:{ display:false }, suggestedMin:60, suggestedMax:100 } } }
    });
  }

  // ── REFRESH KPIs ──
  function refreshKPIs() {
    function rand(base, range) { return base + (Math.random() - 0.5) * range; }
    document.getElementById('kpi-rev').textContent   = '$' + Math.round(rand(84291,5000)).toLocaleString();
    document.getElementById('kpi-users').textContent = Math.round(rand(3847,300)).toLocaleString();
    document.getElementById('kpi-conv').textContent  = rand(4.7,0.4).toFixed(1) + '%';
    var m = Math.round(rand(3,1)), s = Math.abs(Math.round(rand(22,20)));
    document.getElementById('kpi-sess').textContent  = m + 'm ' + s + 's';
  }
</script>
