<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>To-Do App</title>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0a0a0f;
      --surface: #111118;
      --surface2: #16161f;
      --border: #1e1e2e;
      --accent: #7c6ff7;
      --accent3: #6ff7c4;
      --accent2: #f7786f;
      --warn: #f7c56f;
      --text: #e8e8f0;
      --muted: #5a5a7a;
      --font: 'Syne', sans-serif;
      --mono: 'JetBrains Mono', monospace;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAV */
    nav {
      position: sticky; top: 0; z-index: 100;
      background: rgba(10,10,15,0.9);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--border);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2.5rem; height: 58px;
    }
    .nav-logo { font-size: 1rem; font-weight: 800; color: var(--accent); letter-spacing: -0.02em; }
    .nav-back { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); cursor: pointer; text-decoration: none; transition: color 0.15s; }
    .nav-back:hover { color: var(--text); }

    /* MAIN */
    main { flex: 1; max-width: 680px; width: 100%; margin: 0 auto; padding: 3rem 1.5rem 4rem; }

    /* HEADER */
    .app-header { margin-bottom: 2.5rem; }
    .app-tag { font-family: var(--mono); font-size: 0.7rem; color: var(--accent); letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.75rem; }
    .app-title { font-size: 3rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
    .app-title span { color: var(--accent); }
    .app-subtitle { font-family: var(--mono); font-size: 0.82rem; color: var(--muted); margin-top: 0.75rem; }

    /* STATS ROW */
    .stats-row {
      display: flex; gap: 1rem; margin-bottom: 2rem;
    }
    .stat-pill {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.6rem 1rem;
      font-family: var(--mono); font-size: 0.75rem; color: var(--muted);
      display: flex; align-items: center; gap: 0.5rem;
    }
    .stat-pill strong { color: var(--text); font-size: 1rem; font-family: var(--font); font-weight: 700; }

    /* INPUT */
    .input-row {
      display: flex; gap: 0.75rem; margin-bottom: 1.5rem;
    }
    .todo-input {
      flex: 1;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 0.85rem 1.25rem;
      font-family: var(--mono); font-size: 0.88rem; color: var(--text);
      outline: none; transition: border-color 0.2s;
    }
    .todo-input::placeholder { color: var(--muted); }
    .todo-input:focus { border-color: var(--accent); }

    .add-btn {
      background: var(--accent); color: #fff; border: none;
      border-radius: 10px; padding: 0.85rem 1.5rem;
      font-family: var(--font); font-weight: 700; font-size: 0.88rem;
      cursor: pointer; transition: opacity 0.2s, transform 0.15s;
      white-space: nowrap;
    }
    .add-btn:hover { opacity: 0.88; transform: translateY(-1px); }
    .add-btn:active { transform: translateY(0); }

    /* FILTER TABS */
    .filter-row {
      display: flex; gap: 6px; margin-bottom: 1.5rem;
    }
    .filter-btn {
      font-family: var(--mono); font-size: 0.75rem;
      padding: 5px 14px; border-radius: 20px;
      border: 1px solid var(--border);
      background: transparent; color: var(--muted);
      cursor: pointer; transition: all 0.15s;
    }
    .filter-btn:hover { color: var(--text); border-color: #333; }
    .filter-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }

    /* TASK LIST */
    .task-list { display: flex; flex-direction: column; gap: 0.6rem; }

    .task-item {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; padding: 1rem 1.25rem;
      display: flex; align-items: center; gap: 1rem;
      transition: border-color 0.2s, transform 0.15s, opacity 0.3s;
      animation: slideIn 0.25s ease forwards;
    }
    .task-item:hover { border-color: #2a2a3e; transform: translateX(3px); }
    .task-item.done { opacity: 0.45; }
    .task-item.done .task-text { text-decoration: line-through; color: var(--muted); }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .task-check {
      width: 22px; height: 22px; border-radius: 50%;
      border: 1.5px solid var(--border);
      background: transparent; cursor: pointer;
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .task-check:hover { border-color: var(--accent3); }
    .task-item.done .task-check {
      background: var(--accent3); border-color: var(--accent3);
    }
    .task-check::after {
      content: '✓'; font-size: 12px; color: #000;
      opacity: 0; transition: opacity 0.15s;
    }
    .task-item.done .task-check::after { opacity: 1; }

    .task-text {
      flex: 1; font-size: 0.92rem; font-weight: 500; line-height: 1.4;
      transition: color 0.2s;
    }

    .task-meta {
      font-family: var(--mono); font-size: 0.68rem; color: var(--muted);
      flex-shrink: 0;
    }

    .task-delete {
      width: 28px; height: 28px; border-radius: 8px;
      border: 1px solid transparent; background: transparent;
      color: var(--muted); cursor: pointer; font-size: 1rem;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s; flex-shrink: 0;
    }
    .task-delete:hover { background: rgba(247,120,111,0.12); color: var(--accent2); border-color: rgba(247,120,111,0.3); }

    /* PRIORITY DOT */
    .priority {
      width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0;
    }
    .p-high   { background: var(--accent2); box-shadow: 0 0 6px var(--accent2); }
    .p-medium { background: var(--warn); }
    .p-low    { background: var(--accent3); }

    /* PRIORITY SELECT */
    .priority-select {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.85rem 0.75rem;
      font-family: var(--mono); font-size: 0.78rem; color: var(--muted);
      outline: none; cursor: pointer;
    }

    /* EMPTY STATE */
    .empty {
      text-align: center; padding: 4rem 0;
      font-family: var(--mono); font-size: 0.85rem; color: var(--muted);
      display: none;
    }
    .empty-icon { font-size: 2.5rem; margin-bottom: 1rem; opacity: 0.4; }

    /* CLEAR BTN */
    .clear-btn {
      font-family: var(--mono); font-size: 0.75rem; color: var(--muted);
      background: none; border: none; cursor: pointer;
      margin-top: 1.5rem; display: block; margin-left: auto;
      transition: color 0.15s;
    }
    .clear-btn:hover { color: var(--accent2); }

    footer {
      border-top: 1px solid var(--border); padding: 1.25rem 2.5rem;
      display: flex; justify-content: space-between;
      font-family: var(--mono); font-size: 0.72rem; color: var(--muted);
    }

    @media (max-width: 500px) {
      nav { padding: 0 1rem; }
      main { padding: 2rem 1rem 3rem; }
      .app-title { font-size: 2.2rem; }
      .input-row { flex-direction: column; }
      .stats-row { flex-wrap: wrap; }
    }
  </style>
</head>
<body>

<nav>
  <div class="nav-logo">DK</div>
  <a class="nav-back" href="index.html">← Back to Portfolio</a>
</nav>

<main>
  <div class="app-header">
    <div class="app-tag">// project 03</div>
    <div class="app-title">To-Do <span>App</span></div>
    <div class="app-subtitle">Tasks saved in localStorage — nothing gets lost on refresh.</div>
  </div>

  <div class="stats-row">
    <div class="stat-pill"><strong id="count-total">0</strong> total</div>
    <div class="stat-pill"><strong id="count-open">0</strong> open</div>
    <div class="stat-pill"><strong id="count-done">0</strong> done</div>
  </div>

  <div class="input-row">
    <input class="todo-input" id="task-input" type="text" placeholder="Add a new task..." maxlength="120" />
    <select class="priority-select" id="priority-select">
      <option value="low">🟢 Low</option>
      <option value="medium" selected>🟡 Medium</option>
      <option value="high">🔴 High</option>
    </select>
    <button class="add-btn" onclick="addTask()">+ Add</button>
  </div>

  <div class="filter-row">
    <button class="filter-btn active" data-filter="all" onclick="setFilter('all')">All</button>
    <button class="filter-btn" data-filter="open" onclick="setFilter('open')">Open</button>
    <button class="filter-btn" data-filter="done" onclick="setFilter('done')">Done</button>
  </div>

  <div class="task-list" id="task-list"></div>
  <div class="empty" id="empty-state">
    <div class="empty-icon">✓</div>
    No tasks here.
  </div>

  <button class="clear-btn" onclick="clearDone()">Clear completed tasks</button>
</main>

<footer>
  <span>© 2025 Daniel Krba</span>
  <span>Built with HTML, CSS & JS · localStorage</span>
</footer>

<script>
  var tasks = JSON.parse(localStorage.getItem('yn-tasks') || '[]');
  var filter = 'all';

  function save() {
    localStorage.setItem('yn-tasks', JSON.stringify(tasks));
  }

  function addTask() {
    var input = document.getElementById('task-input');
    var text = input.value.trim();
    if (!text) { input.focus(); return; }
    var priority = document.getElementById('priority-select').value;
    tasks.unshift({
      id: Date.now(),
      text: text,
      done: false,
      priority: priority,
      date: new Date().toLocaleDateString('en-GB', { day:'numeric', month:'short' })
    });
    input.value = '';
    save();
    render();
  }

  function toggleDone(id) {
    tasks = tasks.map(function(t) {
      return t.id === id ? Object.assign({}, t, { done: !t.done }) : t;
    });
    save(); render();
  }

  function deleteTask(id) {
    tasks = tasks.filter(function(t) { return t.id !== id; });
    save(); render();
  }

  function clearDone() {
    tasks = tasks.filter(function(t) { return !t.done; });
    save(); render();
  }

  function setFilter(f) {
    filter = f;
    document.querySelectorAll('.filter-btn').forEach(function(b) {
      b.classList.toggle('active', b.dataset.filter === f);
    });
    render();
  }

  function render() {
    var list = document.getElementById('task-list');
    var empty = document.getElementById('empty-state');
    var filtered = tasks.filter(function(t) {
      if (filter === 'open') return !t.done;
      if (filter === 'done') return t.done;
      return true;
    });

    document.getElementById('count-total').textContent = tasks.length;
    document.getElementById('count-open').textContent  = tasks.filter(function(t){ return !t.done; }).length;
    document.getElementById('count-done').textContent  = tasks.filter(function(t){ return t.done; }).length;

    if (filtered.length === 0) {
      list.innerHTML = '';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';

    list.innerHTML = filtered.map(function(t) {
      var pClass = t.priority === 'high' ? 'p-high' : t.priority === 'medium' ? 'p-medium' : 'p-low';
      return '<div class="task-item' + (t.done ? ' done' : '') + '" id="task-' + t.id + '">' +
        '<div class="priority ' + pClass + '"></div>' +
        '<button class="task-check" onclick="toggleDone(' + t.id + ')"></button>' +
        '<div class="task-text">' + escHtml(t.text) + '</div>' +
        '<div class="task-meta">' + t.date + '</div>' +
        '<button class="task-delete" onclick="deleteTask(' + t.id + ')" title="Delete">✕</button>' +
      '</div>';
    }).join('');
  }

  function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // Enter key
  document.getElementById('task-input').addEventListener('keydown', function(e) {
    if (e.key === 'Enter') addTask();
  });

  // Seed tasks if empty
  if (tasks.length === 0) {
    tasks = [
      { id: 1, text: 'Set up GitHub profile and bio', done: true,  priority: 'high',   date: '20 Jan' },
      { id: 2, text: 'Finish portfolio website',      done: true,  priority: 'high',   date: '21 Jan' },
      { id: 3, text: 'Build analytics dashboard',     done: false, priority: 'medium', date: '22 Jan' },
      { id: 4, text: 'Learn Chart.js basics',         done: false, priority: 'low',    date: '22 Jan' },
      { id: 5, text: 'Deploy to GitHub Pages',        done: false, priority: 'medium', date: '23 Jan' },
    ];
    save();
  }

  render();
</script>
</body>
</html>
